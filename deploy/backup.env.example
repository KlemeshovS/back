# Copy this file to /etc/wobbly/backup.env on the server.

# Preferred: use DATABASE_URL exactly as the app uses it.
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app

# Optional explicit PG* variables if you do not want to use DATABASE_URL.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=app
# PGUSER=app
# PGPASSWORD=change-me

BACKUP_ROOT=/var/backups/wobbly-postgres
LOCAL_RETENTION_DAYS=7
BACKUP_PREFIX=wobbly-postgres

# Enable offsite copy with rclone.
OFFSITE_ENABLED=true
RCLONE_REMOTE=remote-name
RCLONE_DESTINATION=wobbly-backups/postgres-production

