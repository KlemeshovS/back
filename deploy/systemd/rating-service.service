[Unit]
Description=Rating Service API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=ratingapp
Group=ratingapp
WorkingDirectory=/opt/rating-service/backend
EnvironmentFile=/opt/rating-service/.env
ExecStart=/opt/rating-service/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
