# Copy this file to /etc/wobbly/telegram-status-bot.env on the server.

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_STATUS_ALLOWED_CHAT_ID=-1001234567890

STATUS_API_HEALTH_URL=https://api.wobbly.site/health
STATUS_API_READY_URL=https://api.wobbly.site/ready

TELEGRAM_STATUS_POLL_TIMEOUT=30
TELEGRAM_STATUS_REQUEST_TIMEOUT=10
